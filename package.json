{
  "name": "metal",
  "version": "0.1.0",
  "private": true,
  "description": "Metal - Prisma-like DX for graph databases (monorepo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielvfonseca/metal.git"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "test:coverage": "turbo run test:coverage",
    "test:root": "vitest run",
    "test:root:ci": "vitest run --reporter=verbose",
    "lint": "ultracite check",
    "typecheck": "turbo run typecheck",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^2.27.1",
    "@t3-oss/env-core": "^0.13.11",
    "@types/node": "^20.10.0",
    "husky": "^9.1.7",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0",
    "ultracite": "^8.0.1",
    "vitest": "^1.0.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  }
}

{
  "name": "@metal/core",
  "version": "0.1.0",
  "description": "Metal - Prisma-like DX for graph databases",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielvfonseca/metal.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/gabrielvfonseca/metal/tree/master/packages/core#readme",
  "bugs": {
    "url": "https://github.com/gabrielvfonseca/metal/issues"
  },
  "keywords": [
    "ogm",
    "graph",
    "neo4j",
    "cypher",
    "database",
    "typescript",
    "orm"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.mjs",
      "require": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.mjs",
      "require": "./dist/query/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.mjs",
      "require": "./dist/config/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist .turbo coverage",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@metal/neo4j-driver": "workspace:^",
    "@types/node": "^20.10.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "zod": "^4.6.7"
  }
}
